# GitHub Configuration
VITE_GITHUB_TOKEN=your_github_token_here

# Gemini API (for commit message generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Admin Panel Password for Ads Management
VITE_ADMIN_PASSWORD=548413

# Backend API URL (CRITICAL FOR VERCEL DEPLOYMENT)
# Set this on Vercel to make ads work for all users
# Example: https://your-backend.onrender.com
VITE_API_BASE_URL=

# Firebase Config (optional - not currently used for ads)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
